{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "zmblocks/button",
  "version": "1.2.4",
  "title": "ZM Button",
  "category": "zmblocks",
  "icon": "button",
  "description": "A UIkit link button with an optional local icon.",
  "keywords": [
    "button",
    "link",
    "uikit"
  ],
  "textdomain": "zmblocks",
  "attributes": {
    "label": {
      "type": "string",
      "default": "Button"
    },
    "url": {
      "type": "string",
      "default": ""
    },
    "newTab": {
      "type": "boolean",
      "default": false
    },
    "variant": {
      "type": "string",
      "enum": [
        "default",
        "primary",
        "secondary",
        "danger",
        "text",
        "link"
      ],
      "default": "default"
    },
    "size": {
      "type": "string",
      "enum": [
        "default",
        "small",
        "large"
      ],
      "default": "default"
    },
    "alignment": {
      "type": "string",
      "enum": [
        "left",
        "center",
        "right"
      ],
      "default": "left"
    },
    "fullWidth": {
      "type": "boolean",
      "default": false
    },
    "iconEnabled": {
      "type": "boolean",
      "default": false
    },
    "icon": {
      "type": "string",
      "enum": [
        "500px",
        "album",
        "android-robot",
        "android",
        "apple",
        "arrow-down-arrow-up",
