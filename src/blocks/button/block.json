        "chevron-up",
        "clock",
        "close-circle",
        "close",
        "cloud-download",
        "cloud-upload",
        "code",
        "cog",
        "comment",
        "commenting",
        "comments",
        "copy",
        "credit-card",
        "crosshairs",
        "database",
        "desktop",
